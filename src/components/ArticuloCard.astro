---
interface Props {
	titulo: string;
	fecha?: string;
	resumen?: string;
	imagen?: string;
	slug: string;
}

const { titulo, fecha, resumen, imagen, slug } = Astro.props;
const fechaFormateada = fecha
	? new Date(fecha).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })
	: '';
---

<a href={`/diario/${slug}`} class="articulo-card">
	{imagen ? (
		<img
			src={`${imagen}/m/600x340/filters:format(webp)`}
			alt={titulo}
			class="articulo-card__imagen"
			width="600"
			height="340"
			loading="lazy"
		/>
	) : (
		<div class="articulo-card__imagen articulo-card__imagen--placeholder">
			<span>Diario</span>
		</div>
	)}
	<div class="articulo-card__info">
		<h3 class="articulo-card__titulo">{titulo}</h3>
		{fechaFormateada && <time class="articulo-card__fecha">{fechaFormateada}</time>}
		{resumen && <p class="articulo-card__resumen">{resumen}</p>}
	</div>
</a>

<style>
	.articulo-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s;
	}

	.articulo-card:hover {
		transform: translateY(-4px);
	}

	.articulo-card__imagen {
		border-radius: var(--radius-l);
		width: 100%;
		aspect-ratio: 600/340;
		object-fit: cover;
	}

	.articulo-card__imagen--placeholder {
		background-color: var(--color-light-blue);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.articulo-card__imagen--placeholder span {
		font-family: var(--font-heading);
		font-size: var(--fs-h3);
		color: var(--color-white);
		font-weight: var(--fw-medium);
	}

	.articulo-card__info {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.articulo-card__titulo {
		font-family: var(--font-heading);
		font-size: var(--fs-h3);
		color: var(--color-dark-blue);
		font-weight: var(--fw-medium);
	}

	.articulo-card__fecha {
		font-size: var(--fs-body);
		color: var(--color-blue);
		font-weight: var(--fw-medium);
	}

	.articulo-card__resumen {
		font-size: var(--fs-body);
		color: var(--color-black);
		opacity: 0.7;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
