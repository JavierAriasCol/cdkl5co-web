---
import Layout from '../../layouts/Layout.astro';
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { slug } = Astro.params;
const storyblokApi = useStoryblokApi();

let story;
try {
	const { data } = await storyblokApi.get(`cdn/stories/diario/${slug}`, {
		version: 'draft',
	});
	story = data?.story;
} catch {
	return Astro.redirect('/diario');
}

if (!story) {
	return Astro.redirect('/diario');
}
---

<Layout title={`${story.content.titulo} - CDKL5 Colombia`} description={story.content.resumen || `Artículo: ${story.content.titulo}`}>
	<StoryblokComponent blok={story.content} />
</Layout>
